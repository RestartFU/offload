# Minecraft Bedrock through the mcpelauncher fork (a flatpak), headless: Xvfb + llvmpipe.
# The fork and its KDE runtime install into a persistent volume on first use (see the session's
# prepare step), so this image stays small and rebuilds never re-download them.
FROM offload/base
RUN apt-get update && apt-get install -y --no-install-recommends dbus dbus-x11 flatpak xauth xdotool xvfb && rm -rf /var/lib/apt/lists/* # offload:packages
RUN curl -fsSL https://bun.sh/install | BUN_INSTALL=/usr/local bash >/dev/null
RUN printf '%s\n' '#!/bin/sh' \
      "exec xvfb-run -a -s '-screen 0 1920x1080x24 -nolisten tcp' flatpak run --user --socket=x11 --nosocket=wayland --env=LIBGL_ALWAYS_SOFTWARE=1 --command=mcpelauncher-client io.mrarm.mcpelauncher \"\$@\"" \
      > /usr/local/bin/mcpelauncher-headless \
 && printf '%s\n' '#!/bin/sh' 'set -e' \
      'export XDG_RUNTIME_DIR=/tmp/xdg-runtime; mkdir -p -m 700 "$XDG_RUNTIME_DIR"' \
      '[ -S /run/dbus/system_bus_socket ] || { mkdir -p /run/dbus && dbus-daemon --system --fork; }  # flatpak run needs a system bus' \
      'flatpak --user remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo' \
      'flatpak --user remote-add --if-not-exists --no-gpg-verify mcpelauncher-fork file:///opt/flatpak-fork-repo' \
      'if ! flatpak --user info io.mrarm.mcpelauncher >/dev/null 2>&1; then' \
      '  flatpak --user install -y --noninteractive mcpelauncher-fork io.mrarm.mcpelauncher' \
      'elif [ "$1" = --update ]; then' \
      '  flatpak --user update -y --noninteractive io.mrarm.mcpelauncher' \
      'fi' > /usr/local/bin/minecraft-prepare \
 && printf '%s\n' '#!/bin/sh' 'set -e' \
      'minecraft-prepare >&2' \
      'export XDG_RUNTIME_DIR=/tmp/xdg-runtime' \
      'exec dbus-run-session -- bun run /opt/mcpelauncher-agent/src/index.ts' > /usr/local/bin/minecraft-mcp \
 && chmod +x /usr/local/bin/mcpelauncher-headless /usr/local/bin/minecraft-prepare /usr/local/bin/minecraft-mcp
